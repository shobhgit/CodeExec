# AWS Region where you want to deploy
aws_region = "us-east-1"

# Instance type for a small prototype; increase capacity for concurrent executions.
instance_type = "t3.micro"

# SSH is disabled by default. Systems Manager Session Manager is configured for access.
# To enable SSH, set both values and restrict the CIDR to your public IP:
# key_name         = "CodeExec-server"
# allowed_ssh_cidr = "198.51.100.4/32"
